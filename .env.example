# Copy to .env and adjust.

# Which version of the prebuilt images to pull: latest (current main),
# a release such as 1.2.0, or a commit such as sha-89f1785.
BUDGIE_VERSION=latest
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Hostname Traefik serves Budgie on.
BUDGIE_HOST=budgie.example.lan

# Name of the Docker network Traefik is attached to.
TRAEFIK_NETWORK=traefik
# Entrypoint and TLS, matching your Traefik configuration.
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_TLS=true

# Set to false only if Budgie is served without HTTPS.
# Otherwise the browser will not send the session cookie.
BUDGIE_COOKIE_SECURE=true

# --- FinTS bank sync (optional; without these values only CSV import is available) ---
# Key used to encrypt the stored online banking login.
# Generate once with: openssl rand -base64 32
# Keep it safe: without it, stored bank connections can no longer be decrypted.
BUDGIE_SECRET_KEY=
# Product ID from the free FinTS product registration (https://www.hbci-zka.de/register/prod_register.htm)
BUDGIE_FINTS_PRODUCT_ID=

# --- AI categorization (runs locally, no cloud) ---
# The built-in classifier is always active and learns from your corrections.
# At or above this confidence (0–1) it assigns the category itself; below it only suggests one.
BUDGIE_AI_AUTO_THRESHOLD=0.6
# Optional: local language model via Ollama for uncertain cases.
# Run "docker compose --profile ai up -d" and "docker compose exec ollama ollama pull qwen2.5:7b".
# Leave empty to disable.
BUDGIE_OLLAMA_URL=
BUDGIE_OLLAMA_MODEL=qwen2.5:7b
