{
	"name": "budgie-web",
	"version": "0.3.0",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage"
	},
	"devDependencies": {
		"@eslint/js": "9.39.5",
		"@fontsource-variable/inter": "5.3.0",
		"@lucide/svelte": "1.81.0",
		"@sveltejs/adapter-node": "6.0.6",
		"@sveltejs/kit": "3.4.1",
		"@sveltejs/vite-plugin-svelte": "7.3.2",
		"@types/node": "26.6.11",
		"@vitest/coverage-v8": "5.1.2",
		"eslint": "9.39.5",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.24.1",
		"globals": "17.14.0",
		"prettier": "3.10.1",
		"prettier-plugin-svelte": "4.2.0",
		"svelte": "5.59.2",
		"svelte-check": "4.7.8",
		"typescript": "6.0.3",
		"typescript-eslint": "8.74.0",
		"vite": "8.4.0",
		"vitest": "5.1.2"
	}
}
